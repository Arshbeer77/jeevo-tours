# Environment Variables for Jeevo Tours CRM

# Database Configuration
# For local development (SQLite) - leave commented or use SQLite URL
# DATABASE_URL=sqlite:///./jeevo_crm.db

# For production (PostgreSQL on Render) - uncomment and set your connection string
# DATABASE_URL=postgresql://user:password@host:port/database

# Admin Authentication (Optional - for production)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-secure-password-here

# Server Configuration
# PORT=8000

# CORS Origins (Optional - for production)
# Comma-separated list of allowed origins
# ALLOWED_ORIGINS=https://jeevotours.com,https://www.jeevotours.com
